# =============================================================================
# MedSwin — evidence-gated multi-agent CDSS + naive-RAG control
# Copy to .env and fill secrets. Never commit .env.
# Manuals: docs/README.md, docs/OPERATOR.md, docs/ENDPOINTS.md
# API listen port is APP_PORT (8100). Port 8000 below is the supervisor LLM.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8100
APP_NAME=MedSwin
DEBUG=false
VERSION=1.1.0

# CORS settings
ALLOWED_ORIGINS=["*"]

# Cloud mode with Azure AI
CLOUD_MODE=false
CLOUD_MODEL=gpt-5.4
CLOUD_EMBEDDING=embed-v-4-0
CLOUD_RERANKER=Cohere-rerank-v4.0-fast
CLOUD_EMBEDDING_DIMENSION=
CLOUD_RERANKER_URI=https://parth-miy1kx0s-eastus2.services.ai.azure.com/providers/cohere/v2/rerank
CLOUD_EMBED_BATCH_SIZE=64
CLOUD_EMBED_BATCH_DELAY_S=60
AZURE_AI_FOUNDRY_ENDPOINT=your-endpoint
AZURE_AI_FOUNDRY_API_KEY=your-key

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=medswin

# -----------------------------------------------------------------------------
# Model Endpoints (OpenAI-compatible assumed)
# -----------------------------------------------------------------------------
# Supervisor model endpoint (port 8000)
SUPERVISOR_URL=http://localhost:8000/v1/chat/completions

# Specialist agent endpoints (ports 8001-8003)
AGENT1_URL=http://localhost:8001/v1/chat/completions
AGENT2_URL=http://localhost:8002/v1/chat/completions
AGENT3_URL=http://localhost:8003/v1/chat/completions

# Reranker endpoint (port 8004)
RERANKER_URL=http://localhost:8004/rerank

# Embedding endpoint (port 8005)
EMBEDDING_URL=http://localhost:8005/embeddings

# -----------------------------------------------------------------------------
# Service Timeouts (seconds)
# -----------------------------------------------------------------------------
LLM_TIMEOUT_S=60
RERANK_TIMEOUT_S=30
EMBED_TIMEOUT_S=30
MODEL_RATE_LIMIT_MAX_ATTEMPTS=6
MODEL_RATE_LIMIT_MAX_CONCURRENCY=2
MODEL_RATE_LIMIT_BASE_COOLDOWN_S=600
MODEL_RATE_LIMIT_MAX_COOLDOWN_S=1800
MODEL_RATE_LIMIT_JITTER_S=0.25

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
DEFAULT_TOP_K=5
NAIVE_TOP_K=5
NAIVE_MAX_CONTEXT_CHARS=8000
NAIVE_ENABLE_MONGO_FALLBACK=true
NAIVE_MONGO_SCAN_LIMIT=4000
CANDIDATE_K=80
CANDIDATE_K_PRIME=120
MAX_RETRIEVE_LOOPS=3
TOKEN_BUDGET_B=1800
ENABLE_BM25=true
DEFAULT_INDEX_TYPE=hnsw
INDEX_STRATEGY_MODE=dynamic

# Legacy retrieval settings (for backward compatibility)
MAX_TOP_K=20
RERANK_TOP_K=10
FINAL_TOP_K=3

# -----------------------------------------------------------------------------
# Evidence Sufficiency Policy
# Live gate (app/medswin/gate.py) uses facet LCB / entropy / contradictions.
# SUFF_T_* count gates are legacy knobs kept for older helpers.
# -----------------------------------------------------------------------------
SUFF_FACET_THRESHOLD=0.70
SUFF_CRITICAL_FACET_THRESHOLD=0.78
SUFF_LCB_MARGIN=0.08
SUFF_MAX_ENTROPY=0.88
SUFF_MAX_CONTRADICTIONS=0
SUFF_MIN_MARGINAL_UTILITY=0.0002
SUFF_BOOTSTRAP_N=64
SUFF_T_CPG=2
SUFF_T_EMR=2
SUFF_T_INCLUSION=0.55
SUFF_T_MEAN_CONF=0.60
DEFAULT_CLINICAL_SCOPE=clinician_cds
RERANK_CALIBRATION_PATH=./data/calibration/rerank.json
AGENT_RELIABILITY_PATH=./data/calibration/agents.json

# -----------------------------------------------------------------------------
# Eval harness (eval/ service on :8200; used by ./scripts/start-local.sh eval)
# -----------------------------------------------------------------------------
MEDSWIN_BASE_URL=http://127.0.0.1:8100
EVAL_BASE_URL=http://127.0.0.1:8200
BENCHMARK_ORG_ID=bench-org
BENCHMARK_USER_ID=bench-user
RUN_STORE_DIR=/tmp/medswin-audits
MAX_CASES_DEFAULT=25
REQUEST_TIMEOUT_S=120
DEFAULT_TOKEN_BUDGET=4096
BENCHMARK_RANDOM_SEED=1337
BENCHMARK_CORPUS_SAMPLE_SIZE=5000
BENCHMARK_MAX_TOPICS=30
BENCHMARK_MIN_GOLD_CORPUS_RECALL=0.95
BENCHMARK_MIN_GOLD_INDEX_RECALL=0.95

# -----------------------------------------------------------------------------
# Fusion Score Weights (must sum to 1.0)
# -----------------------------------------------------------------------------
W_RERANK=0.45
W_DENSE=0.25
W_LEX=0.10
W_RECENCY=0.07
W_SECTION=0.08
W_SOURCE=0.05
W_EBM=0.12
W_NOISE=0.20

# -----------------------------------------------------------------------------
# MMR (Maximal Marginal Relevance) Configuration
# -----------------------------------------------------------------------------
MMR_LAMBDA=0.75
MMR_MAX_EVIDENCE_CHUNKS=10
HNSW_MAX_EF_SEARCH=2000
FUSION_LOGIT_CLIP=8.0

# -----------------------------------------------------------------------------
# Enterprise Features (Feature Flags)
# -----------------------------------------------------------------------------
ENABLE_AUTH=false
ENABLE_RBAC=false
ENABLE_OTEL=false
LOG_REDACT_PHI=true
TRACE_REDACT_BY_DEFAULT=true
TRACE_INCLUDE_POLICY_DETAILS=true
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Legacy Model Settings (for backward compatibility)
# -----------------------------------------------------------------------------
# Embedding model path (local checkout: ./models/... ; Docker: /app/models/...)
EMBEDDING_MODEL_PATH=./models/MedEmbed-large-v0.1
EMBEDDING_DIMENSION=768
MAX_SEQUENCE_LENGTH=512

# Reranker model path (if using local models instead of endpoint)
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# Storage Settings
# -----------------------------------------------------------------------------
HNSW_INDEX_PATH=./data/hnsw_index.bin
HNSW_MAPPING_PATH=./data/hnsw_mapping.json
FAISS_INDEX_PATH=./data/faiss_index.bin
FAISS_MAPPING_PATH=./data/faiss_mapping.json
TREE_INDEX_PATH=./data/tree_index.npy
TREE_MAPPING_PATH=./data/tree_mapping.json
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Chunking Settings
# -----------------------------------------------------------------------------
TARGET_CHUNK_SIZE=400
BATCH_SIZE=64

# -----------------------------------------------------------------------------
# File Upload Settings
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=[".csv", ".json", ".txt", ".pdf"]

# -----------------------------------------------------------------------------
# Logging Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# -----------------------------------------------------------------------------
# Hugging Face Settings
# -----------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# AWS Settings (for EC2 deployment)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
EC2_INSTANCE_TYPE=g4dn.xlarge
