# =============================================================================
# MedSwin — evidence-gated multi-agent CDSS + naive-RAG control
# Copy to .env and fill secrets. Never commit .env.
# Manuals: docs/README.md, docs/OPERATOR.md, docs/ENDPOINTS.md
# API listen port is APP_PORT (8100). Port 8000 below is the local MedSwin LLM.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8100
APP_NAME=MedSwin
DEBUG=false
VERSION=1.1.0
ALLOWED_ORIGINS=["*"]

# -----------------------------------------------------------------------------
# Azure AI Foundry evaluation profile
# -----------------------------------------------------------------------------
# Full TREC evaluation requires CLOUD_MODE=true. Ordinary local-only development
# may set this false and use the local embedding/reranker endpoints below.
CLOUD_MODE=true
FOUNDRY_MODEL=gpt-5.4
# Backward-compatible alias used by existing runtime code.
CLOUD_MODEL=gpt-5.4
CLOUD_EMBEDDING=embed-v-4-0
CLOUD_EMBEDDING_DIMENSION=1536
CLOUD_RERANKER=Cohere-rerank-v4.0-fast

# Foundry account root, e.g. https://<account>.services.ai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=your-endpoint
AZURE_AI_FOUNDRY_API_KEY=your-key

# Optional explicit provider routes. Leave blank to derive them from
# AZURE_AI_FOUNDRY_ENDPOINT. embed-v-4-0 uses the Foundry Models embeddings API;
# Cohere rerank uses its provider-specific v2 route.
CLOUD_EMBEDDING_URI=
CLOUD_RERANKER_URI=
CLOUD_MODEL_INFERENCE_API_VERSION=2024-05-01-preview
CLOUD_EMBED_BATCH_SIZE=64
CLOUD_EMBED_BATCH_DELAY_S=60

# Do not set a global Cohere input type for ordinary application operation.
# The complete-corpus builder explicitly uses input_type=document and the strict
# evaluation API subprocess explicitly uses input_type=query. Leaving this blank
# prevents general cloud refresh/ingestion from being accidentally treated as a
# search query simply because the benchmark profile is installed.
CLOUD_EMBEDDING_DEFAULT_INPUT_TYPE=

# Full-corpus builder intentionally relies on provider 429/backoff rather than a
# fixed 60s pause after every batch. Override only when your quota requires it.
FULL_EMBED_BATCH_SIZE=64
FULL_EMBED_BATCH_DELAY_S=0
FULL_INGEST_FLUSH_CHUNKS=512
FULL_DISK_BATCH_SIZE=2048
FULL_HNSW_M=32
FULL_HNSW_EF_CONSTRUCTION=384

# -----------------------------------------------------------------------------
# Generation backend / MedSwin local model
# -----------------------------------------------------------------------------
# foundry       -> GPT-5.4 from Azure Foundry
# medswin_local -> the downloaded MedSwin 7B snapshot served on MEDSWIN_LLM_URL
GENERATION_BACKEND=foundry
MEDSWIN_MODEL_REPO=MedSwin/MedSwin-DaRE-TIES-KD-0.7
MEDSWIN_MODEL_PATH=./models/MedSwin-DaRE-TIES-KD-0.7
MEDSWIN_LLM_MODEL=MedSwin/MedSwin-DaRE-TIES-KD-0.7
MEDSWIN_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
MEDSWIN_LLM_HOST=127.0.0.1
MEDSWIN_LLM_PORT=8000
MEDSWIN_MAX_NEW_TOKENS=1024
MEDSWIN_LLM_STARTUP_TIMEOUT_S=900

# Startup performs model + full TREC materialization + Foundry probes by default.
EVAL_WARMUP_ON_START=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=medswin
MONGODB_DATABASE=medswin

# -----------------------------------------------------------------------------
# Local Model Endpoints (used when CLOUD_MODE=false)
# -----------------------------------------------------------------------------
SUPERVISOR_URL=http://localhost:8000/v1/chat/completions
AGENT1_URL=http://localhost:8001/v1/chat/completions
AGENT2_URL=http://localhost:8002/v1/chat/completions
AGENT3_URL=http://localhost:8003/v1/chat/completions
RERANKER_URL=http://localhost:8004/rerank
EMBEDDING_URL=http://localhost:8005/embeddings

# -----------------------------------------------------------------------------
# Service Timeouts (seconds)
# -----------------------------------------------------------------------------
LLM_TIMEOUT_S=60
RERANK_TIMEOUT_S=30
EMBED_TIMEOUT_S=30
MODEL_RATE_LIMIT_MAX_ATTEMPTS=6
MODEL_RATE_LIMIT_MAX_CONCURRENCY=2
MODEL_RATE_LIMIT_BASE_COOLDOWN_S=600
MODEL_RATE_LIMIT_MAX_COOLDOWN_S=1800
MODEL_RATE_LIMIT_JITTER_S=0.25

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
DEFAULT_TOP_K=5
NAIVE_TOP_K=5
NAIVE_MAX_CONTEXT_CHARS=8000
NAIVE_ENABLE_MONGO_FALLBACK=true
NAIVE_MONGO_SCAN_LIMIT=4000
CANDIDATE_K=80
CANDIDATE_K_PRIME=120
MAX_RETRIEVE_LOOPS=3
TOKEN_BUDGET_B=1800
ENABLE_BM25=true
DEFAULT_INDEX_TYPE=hnsw
INDEX_STRATEGY_MODE=dynamic

# Full-corpus lexical BM25 is SQLite FTS5. Leave blank for ordinary operation.
# The strict full-eval command overrides this with an isolated benchmark path.
LEXICAL_FTS_PATH=
LEXICAL_IN_MEMORY_MAX_CHUNKS=100000

# Legacy retrieval settings
MAX_TOP_K=20
RERANK_TOP_K=10
FINAL_TOP_K=3

# -----------------------------------------------------------------------------
# Evidence Sufficiency Policy
# -----------------------------------------------------------------------------
SUFF_FACET_THRESHOLD=0.70
SUFF_CRITICAL_FACET_THRESHOLD=0.78
SUFF_LCB_MARGIN=0.08
SUFF_MAX_ENTROPY=0.88
SUFF_MAX_CONTRADICTIONS=0
SUFF_MIN_MARGINAL_UTILITY=0.0002
SUFF_BOOTSTRAP_N=64
SUFF_T_CPG=2
SUFF_T_EMR=2
SUFF_T_INCLUSION=0.55
SUFF_T_MEAN_CONF=0.60
DEFAULT_CLINICAL_SCOPE=clinician_cds
RERANK_CALIBRATION_PATH=./data/calibration/rerank.json
AGENT_RELIABILITY_PATH=./data/calibration/agents.json

# -----------------------------------------------------------------------------
# Eval harness
# -----------------------------------------------------------------------------
MEDSWIN_BASE_URL=http://127.0.0.1:8100
EVAL_BASE_URL=http://127.0.0.1:8200
BENCHMARK_ORG_ID=bench-org
BENCHMARK_USER_ID=bench-user
RUN_STORE_DIR=/tmp/medswin-audits
MAX_CASES_DEFAULT=25
REQUEST_TIMEOUT_S=120
DEFAULT_TOKEN_BUDGET=4096
BENCHMARK_RANDOM_SEED=1337
BENCHMARK_CORPUS_SAMPLE_SIZE=5000
BENCHMARK_MAX_TOPICS=30
BENCHMARK_MIN_GOLD_CORPUS_RECALL=0.95
BENCHMARK_MIN_GOLD_INDEX_RECALL=0.95

# Strict full matrix (always 30 cases, irrespective of MAX_CASES_DEFAULT)
FULL_EVAL_API_PORT=8110
FULL_EVAL_TOP_K=5
FULL_EVAL_REQUEST_TIMEOUT_S=600
# Local 7B generation can exceed the ordinary API LLM timeout on CPU or a
# contended GPU. start-local.sh full-eval applies this only to benchmark child
# processes and does not change the normal application timeout above.
FULL_EVAL_LLM_TIMEOUT_S=600
# Strict evaluation artifacts are isolated from the normal local HNSW/BM25
# files so publication preparation cannot overwrite a developer's active index.
FULL_EVAL_DATA_DIR=./data/full-trec-benchmark
FULL_EVAL_HNSW_INDEX_PATH=
FULL_EVAL_HNSW_MAPPING_PATH=
FULL_EVAL_LEXICAL_FTS_PATH=

# -----------------------------------------------------------------------------
# Fusion Score Weights
# -----------------------------------------------------------------------------
W_RERANK=0.45
W_DENSE=0.25
W_LEX=0.10
W_RECENCY=0.07
W_SECTION=0.08
W_SOURCE=0.05
W_EBM=0.12
W_NOISE=0.20

# -----------------------------------------------------------------------------
# MMR / ANN
# -----------------------------------------------------------------------------
MMR_LAMBDA=0.75
MMR_MAX_EVIDENCE_CHUNKS=10
HNSW_MAX_EF_SEARCH=2000
FUSION_LOGIT_CLIP=8.0

# -----------------------------------------------------------------------------
# Enterprise Features
# -----------------------------------------------------------------------------
ENABLE_AUTH=false
ENABLE_RBAC=false
ENABLE_OTEL=false
LOG_REDACT_PHI=true
TRACE_REDACT_BY_DEFAULT=true
TRACE_INCLUDE_POLICY_DETAILS=true
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Legacy local model settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_PATH=./models/MedEmbed-large-v0.1
EMBEDDING_DIMENSION=768
MAX_SEQUENCE_LENGTH=512
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3

# -----------------------------------------------------------------------------
# Storage Settings
# -----------------------------------------------------------------------------
HNSW_INDEX_PATH=./data/hnsw_index.bin
HNSW_MAPPING_PATH=./data/hnsw_mapping.json
FAISS_INDEX_PATH=./data/faiss_index.bin
FAISS_MAPPING_PATH=./data/faiss_mapping.json
TREE_INDEX_PATH=./data/tree_index.npy
TREE_MAPPING_PATH=./data/tree_mapping.json
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Chunking Settings
# -----------------------------------------------------------------------------
TARGET_CHUNK_SIZE=400
BATCH_SIZE=64

# -----------------------------------------------------------------------------
# File Upload Settings
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=[".csv", ".json", ".txt", ".pdf"]

# -----------------------------------------------------------------------------
# Logging Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# -----------------------------------------------------------------------------
# Hugging Face Settings
# -----------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# AWS Settings
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
EC2_INSTANCE_TYPE=g4dn.xlarge
